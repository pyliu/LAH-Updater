<service>
  <id>LAH_Web_Service</id>
  <name>LAH 智慧管控：應用系統入口與 API 閘道服務</name>
  <description>提供地政智慧管控系統前端介面存取、業務查詢 API 轉發與安全反向代理，負責核心通訊連線與身分驗證傳輸。</description>
  <executable>C:\AppServ\Apache24\bin\httpd.exe</executable>
  <arguments>-d C:\AppServ\Apache24</arguments>
  <workingdirectory>C:\AppServ\Apache24</workingdirectory>

  <env name="PATH" value="C:\AppServ\Apache24\bin;C:\AppServ\instantclient_11_2;C:\AppServ\php7;%PATH%" />
  <env name="NLS_LANG" value="American_America.US7ASCII" />

  <logmode>roll-by-size</logmode>
  <logpath>C:\AppServ\logs\web_service</logpath>
  <sizeThreshold>10240</sizeThreshold>
  <keepFiles>10</keepFiles>

  <onfailure action="restart" delay="5 sec"/>
  <onfailure action="restart" delay="15 sec"/>
  <resetfailure>1 hour</resetfailure>
</service>
