{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LAH-Backuper",
  "version": "0.1.0",
  "identifier": "tw.gov.tyland.lah-backuper",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "智慧控管與監控系統 - 備份與還原工具",
        "width": 760,
        "height": 480,
        "minWidth": 660,
        "minHeight": 420,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
