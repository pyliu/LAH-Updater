{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LAH-NodePortable",
  "version": "0.1.0",
  "identifier": "tw.gov.tyland.lah-node-portable",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "智慧控管與監控系統 - 可攜 Node 安裝工具",
        "width": 960,
        "height": 560,
        "minWidth": 860,
        "minHeight": 500,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
