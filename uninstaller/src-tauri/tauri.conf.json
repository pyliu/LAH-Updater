{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "LAH-Uninstaller",
  "version": "0.1.0",
  "identifier": "tw.gov.tyland.lah-uninstaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "智慧控管與監控系統 - 自動移除工具",
        "width": 980,
        "height": 680,
        "minWidth": 860,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
